      Elsie
    </a>

    <div class="hidden items-center gap-6 text-sm text-slate-700 dark:text-slate-300 md:flex">
      <a href="/#services" class="transition-colors hover:text-red-600 dark:hover:text-yellow-400">Services</a>
      <a href="/about" class="transition-colors hover:text-red-600 dark:hover:text-yellow-400">About</a>
